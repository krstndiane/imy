# imy settings. Copy this file to ".env" (same folder) and fill in what you need, then restart imy.
# Never share or upload your .env file: it holds your keys. (.gitignore already keeps it out of GitHub.)

# Check what's set up and working:   python -m backend.services   (and python -m backend.preflight)

# --- AI: Groq, through Pydantic AI -------------------------------------------------------
# Groq reads screenshots, describes shared photos and writes the replies. Required: without it
# screenshots can't be uploaded and replies are imy's own basic ones.
# Free, fast, and doesn't keep what you send by default. Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# When Groq writes a reply:  always   = for everything except what you taught it (default)
#                            fallback = only when imy's own reply isn't confident (saves the free limit)
#                            off      = never (screenshots can't be read either)
# IMY_AI_MODE=always
# Force one model instead of letting imy pick (it asks Groq which ones exist):
# IMY_LLM_MODEL=openai/gpt-oss-120b
# IMY_VISION_MODEL=qwen/qwen3.8-27b

# Daily AI limits (see backend/usage.py). The free Groq allowance is shared by the WHOLE site, so each
# account gets a fair share. Past it, replies still come - written by imy itself - until midnight (TZ).
# 0 means no limit. Set the site ceiling once you pay for the AI and want a cap on the bill.
# IMY_AI_DAILY_PER_ACCOUNT=50
# IMY_AI_DAILY_SITE=0

# --- Database: Turso ----------------------------------------------------------------------
# On the live site the database lives on Turso (hosted SQLite), so the server keeps nothing.
# turso.tech: create a database (pick the region closest to your server), then:
#   turso db show <name> --url            -> IMY_TURSO_URL
#   turso db tokens create <name>         -> IMY_TURSO_TOKEN
# Leave both empty on your own computer: the database is then the file data/imy.db.
IMY_TURSO_URL=
IMY_TURSO_TOKEN=

# --- Pictures: Supabase Storage -------------------------------------------------------------
# Screenshots, profile pictures and shared photos are kept in Supabase, not on the server's disk.
# supabase.com: create a project, then Project Settings > API: the Project URL and the service_role
# key (secret: server only, never in the website). imy creates a private bucket for you.
# Leave both empty on your own computer: pictures then go in data/uploads.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# IMY_SUPABASE_BUCKET=imy-uploads

# --- Other ------------------------------------------------------------------------------
# Your time zone (for "anong oras na?"):
# TZ=Asia/Manila
# When deployed: the address people open, e.g. https://imy.yourdomain.com (only needed if the
# frontend is served from a different address than the backend)
# IMY_ORIGINS=https://imy.pdyntech.com

# --- Accounts and your pages ------------------------------------------------------------
# REQUIRED before you go live: where people write for deletion requests and questions. It's filled in
# on /privacy.html and /terms.html automatically (python -m backend.preflight fails without it).
IMY_CONTACT_EMAIL=
# Who can open the admin page at /admin (usage numbers + the feedback inbox). Comma-separated. There's
# no admin password: /admin emails a one-time sign-in link to one of these addresses. Unset = the
# contact address above is the admin. Admin addresses are never shown on the site.
IMY_ADMIN_EMAILS=
# Where feedback from the app is emailed. Unset = the contact address. IMY_FEEDBACK_EMAILS=0 = don't email it.
IMY_FEEDBACK_TO=
# The sign-in cookie is marked "Secure" (HTTPS only) on every visit that arrives over HTTPS, including
# through your host's proxy. Leave this unset; 1 forces it on, 0 turns it off (never on a live site).
# IMY_SECURE_COOKIES=1

# How many proxies sit in front of imy, so the sign-in limit sees each visitor's real address and
# can't be dodged with a made-up X-Forwarded-For. 1 for most hosts (Render, Railway, Fly);
# 2 with Cloudflare in front of one; 0 when nothing is in front (the header is then ignored).
# IMY_PROXY_HOPS=1

# --- Email: Resend, from pdyntech.com ------------------------------------------------------------
# REQUIRED before you go live (python -m backend.preflight fails without it): "Forgot password" and
# the admin sign-in link are emailed. resend.com: Domains > Add pdyntech.com, add the DNS records it
# shows in Route 53, wait for "Verified", then API Keys > Create (Sending access).
# Test it with:  python -m backend.mailer you@example.com
# On your own computer, leave it empty: the reset link is printed in the Terminal instead.
RESEND_API_KEY=
IMY_MAIL_FROM=imy <no-reply@pdyntech.com>
# The site's address. Links in emails point here (never at whatever address a request claims).
# IMY_PUBLIC_URL=https://imy.pdyntech.com

# Without Resend, any SMTP service works instead (Gmail needs an App Password, never your real one):
# IMY_SMTP_HOST=smtp.gmail.com
# IMY_SMTP_PORT=587
# IMY_SMTP_USER=imy.app@gmail.com
# IMY_SMTP_PASSWORD=
# IMY_MAIL_FROM=imy <imy.app@gmail.com>

# --- Speed ------------------------------------------------------------------------------
# How many people's writing styles to keep worked out in memory. A reply from someone in here takes
# about 9ms instead of 40ms, and each one costs about 0.4 MB. 200 is about 75 MB. Raise it if you
# have plenty of memory and lots of people chatting at once; lower it on a very small server.
# IMY_CACHE_PEOPLE=200

# --- Backups ----------------------------------------------------------------------------
# Make one every 24 hours while imy runs. You can also run it yourself: python -m backend.backup
# With Turso, the backup is the whole Turso database copied into one SQLite file (pictures stay in
# Supabase). Turso also keeps its own point-in-time history.
# Turn this on for any copy real people use.
# IMY_BACKUP_DAILY=1
# How many to keep (default 7), and where they go (default data/backups):
# IMY_BACKUP_KEEP=7
# IMY_BACKUP_DIR=/data/backups
