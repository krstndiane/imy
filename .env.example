# imy settings. Copy this file to ".env" (same folder) and fill in what you need, then restart imy.
# Never share or upload your .env file: it holds your keys. (.gitignore already keeps it out of GitHub.)

# --- Smart replies (free) ------------------------------------------------------------
# Groq: free, fast, and doesn't keep what you send by default. Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# Gemini (optional): used when Groq's free limit is reached. Get a key: https://aistudio.google.com/apikey
# Google's FREE tier says not to send personal information and may let people read what's sent,
# so for real users' chats turn on billing in Google AI Studio first, then set IMY_GEMINI_PAID=1.
GEMINI_API_KEY=
# IMY_GEMINI_PAID=1

# When the AI is used:  fallback = only when imy's own data isn't enough (default, saves the free limit)
#                       always   = for everything except what you taught it;  off = never
# IMY_AI_MODE=fallback

# --- Other ------------------------------------------------------------------------------
# Your time zone (for "anong oras na?"):
# TZ=Asia/Manila
# When deployed: the address people open, e.g. https://imy.yourdomain.com (only needed if the
# frontend is served from a different address than the backend)
# IMY_ORIGINS=https://imy.yourdomain.com

# --- Accounts ---------------------------------------------------------------------------
# The sign-in cookie is marked "Secure" (sent over HTTPS only) unless IMY_ORIGINS contains an
# http:// address, which is how you run imy on your own computer. Set this to force it either way.
# IMY_SECURE_COOKIES=1

# --- Speed ------------------------------------------------------------------------------
# How many people's writing styles to keep worked out in memory. A reply from someone in here takes
# about 9ms instead of 40ms, and each one costs about 0.4 MB. 200 is about 75 MB. Raise it if you
# have plenty of memory and lots of people chatting at once; lower it on a very small server.
# IMY_CACHE_PEOPLE=200

# --- Backups ----------------------------------------------------------------------------
# Make one every 24 hours while imy runs. You can also run it yourself: python -m backend.backup
# IMY_BACKUP_DAILY=1
# How many to keep (default 7), and where they go (default data/backups):
# IMY_BACKUP_KEEP=7
# IMY_BACKUP_DIR=/data/backups
